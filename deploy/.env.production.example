# server/.env on the production host — never commit the real file.
NODE_ENV=production
API_PORT=4000
DATABASE_URL="file:./prisma/prod.db"
APP_URL="https://returns.example.com"
PUBLIC_API_URL="https://returns.example.com"
WEB_DIST="../web/dist"
STORAGE_DIR="./storage"

# Generate each with: openssl rand -hex 32   (different values for staging and production)
SESSION_SECRET=""
ENCRYPTION_KEY=""

# Email delivery (any SMTP provider: SES, Postmark, SendGrid, Zoho…)
SMTP_URL="smtps://user:password@smtp.example.com:465"
MAIL_FROM="Kaveri & Co. Returns <returns@example.com>"
# Where website contact-form messages are sent
CONTACT_INBOX="hello@example.com"

# Optional: AI photo & reason analysis with Claude
ANTHROPIC_API_KEY=""
