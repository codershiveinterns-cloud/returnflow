// ReturnFlow — data model (Milestone 1)
//
// Tenancy
// -------
// `Organization` is the tenant boundary. Every business record (customers,
// orders, returns, integrations, keys, audit entries) carries an
// `organizationId`, and every query in the API is scoped by the organization
// resolved from the authenticated session, API key, or portal slug — never
// from a client-supplied id.
//
// Users are global identities; `Membership` attaches a user to a tenant with
// a role, so one person can later belong to several businesses.
//
// Conventions
// -----------
// * Money is stored as integer minor units (paise / cents) plus the order's
//   ISO currency code. No floats anywhere near a refund.
// * Enumerations are stored as strings and validated in the application layer
//   (see src/returns/status.ts, src/auth/rbac.ts) so the schema stays portable
//   between SQLite (local/staging) and PostgreSQL (production).
// * Secrets (Shopify tokens, webhook secrets) are AES-256-GCM encrypted at the
//   application layer before they reach the database.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Organization {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  currency          String   @default("INR")
  brandColor        String   @default("#1f2a37")
  logoKey           String?
  supportEmail      String?
  portalHeadline    String?
  returnWindowDays  Int      @default(30)
  // Return policy (eligibility engine)
  nonReturnableCategories String @default("[]") // JSON string[]
  autoApproveMaxMinor     Int    @default(500000) // auto-approve requests up to this value
  maxReturnsPer90Days     Int    @default(3) // more than this sends the request to review
  requirePhotoForDamage   Boolean @default(true)
  webhookSecretEnc  String
  nextReturnNumber  Int      @default(1001)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  memberships   Membership[]
  customers     Customer[]
  orders        Order[]
  orderItems    OrderItem[]
  returns       ReturnRequest[]
  returnPhotos  ReturnPhoto[]
  returnEvents  ReturnEvent[]
  integrations  Integration[]
  apiKeys       ApiKey[]
  syncRuns      SyncRun[]
  auditLogs     AuditLog[]
  rules         AutomationRule[]
  shipments     Shipment[]
  notifications Notification[]
  inspections   Inspection[]
  refunds       Refund[]
  inventory     InventoryMovement[]
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships Membership[]
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           String // admin | manager | support | warehouse | finance
  status         String       @default("active") // active | disabled
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  name           String?
  phone          String?
  externalId     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders       Order[]
  returns      ReturnRequest[]

  @@unique([organizationId, email])
}

model Order {
  id              String    @id @default(cuid())
  organizationId  String
  customerId      String
  orderNumber     String
  externalId      String?
  source          String // shopify | api | webhook | csv
  status          String // pending | fulfilled | delivered | cancelled
  paymentMethod   String    @default("prepaid") // prepaid | cod
  currency        String
  totalMinor      Int
  paymentRef      String? // gateway payment id (e.g. Razorpay pay_…), used for refunds
  placedAt        DateTime
  deliveredAt     DateTime?
  shippingAddress String? // JSON
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer        @relation(fields: [customerId], references: [id])
  items        OrderItem[]
  returns      ReturnRequest[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId, placedAt])
  @@index([organizationId, source])
}

model OrderItem {
  id             String  @id @default(cuid())
  organizationId String
  orderId        String
  lineKey        String // external line id, or SKU when the source has none
  sku            String
  name           String
  variant        String?
  category       String?
  quantity       Int
  unitPriceMinor Int
  imageUrl       String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  returnItems  ReturnItem[]

  @@unique([orderId, lineKey])
  @@index([organizationId, sku])
}

model ReturnRequest {
  id             String   @id @default(cuid())
  organizationId String
  number         Int
  orderId        String
  customerId     String
  status         String // see src/returns/status.ts
  resolution     String // refund | store_credit | replacement
  channel        String   @default("portal") // portal | staff
  customerNote   String?
  valueMinor     Int
  currency       String
  // Eligibility & decision trail
  eligibility     String? // JSON: { checks, outcome, matchedRules }
  flags           String   @default("[]") // JSON string[]
  requiresManager Boolean  @default(false)
  escalatedAt     DateTime?
  decisionReason  String?
  decidedById     String?
  decidedAt       DateTime?
  // Risk & resolution (Milestone 3)
  riskScore       Int?
  riskLevel       String? // low | medium | high
  riskFactors     String   @default("[]") // JSON [{ label, points }]
  holdRefund      Boolean  @default(false)
  resolvedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        Order         @relation(fields: [orderId], references: [id])
  customer     Customer      @relation(fields: [customerId], references: [id])
  items        ReturnItem[]
  photos       ReturnPhoto[]
  events       ReturnEvent[]
  shipment     Shipment?
  notifications Notification[]
  inspections  Inspection[]
  refunds      Refund[]
  inventory    InventoryMovement[]

  @@unique([organizationId, number])
  @@index([organizationId, status, createdAt])
}

model ReturnItem {
  id           String  @id @default(cuid())
  returnId     String
  orderItemId  String
  quantity     Int
  reason       String // see src/returns/reasons.ts
  reasonDetail String?
  // AI-assisted reason analysis
  aiReason     String? // classified reason code
  aiSummary    String?
  aiConfidence Float?
  aiSource     String? // claude | rules

  returnRequest ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id])
  photos        ReturnPhoto[]
  inspection    Inspection?
}

model ReturnPhoto {
  id             String   @id @default(cuid())
  organizationId String
  returnId       String
  returnItemId   String?
  storageKey     String
  mimeType       String
  sizeBytes      Int
  uploadedBy     String   @default("customer") // customer | staff
  createdAt      DateTime @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  returnRequest ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  returnItem    ReturnItem?   @relation(fields: [returnItemId], references: [id], onDelete: Cascade)
}

model ReturnEvent {
  id             String   @id @default(cuid())
  organizationId String
  returnId       String
  type           String // status | note | system
  status         String?
  message        String
  actorType      String // customer | user | system
  actorId        String?
  actorLabel     String?
  createdAt      DateTime @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  returnRequest ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId, createdAt])
}

model Integration {
  id             String    @id @default(cuid())
  organizationId String
  provider       String // shopify
  mode           String    @default("live") // live | sandbox
  displayName    String
  configEnc      String // encrypted JSON (shop domain, access token, API secret)
  status         String    @default("connected") // connected | error | disconnected
  lastError      String?
  lastSyncedAt   DateTime?
  syncCursor     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
}

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  prefix         String    @unique
  hash           String
  createdById    String?
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model SyncRun {
  id             String    @id @default(cuid())
  organizationId String
  source         String // shopify | api | webhook | csv
  trigger        String // manual | webhook | api | upload | schedule
  status         String // running | success | partial | failed
  label          String?
  received       Int       @default(0)
  created        Int       @default(0)
  updated        Int       @default(0)
  failed         Int       @default(0)
  errors         String? // JSON array of { ref, message }
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, startedAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorType      String // user | customer | api_key | system
  actorId        String?
  actorLabel     String
  action         String
  entityType     String?
  entityId       String?
  meta           String? // JSON
  ip             String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// ───────────────────────── Milestone 2 ─────────────────────────

/// IF/THEN rule evaluated against every new return request, in priority order.
model AutomationRule {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  enabled        Boolean   @default(true)
  priority       Int       @default(100)
  match          String    @default("all") // all | any
  conditions     String // JSON [{ field, op, value }]
  action         String // auto_approve | auto_reject | require_manager | flag | hold_refund
  actionNote     String?
  matchCount     Int       @default(0)
  lastMatchedAt  DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, priority])
}

/// Reverse pickup for a return: courier, AWB and tracking checkpoints.
model Shipment {
  id             String    @id @default(cuid())
  organizationId String
  returnId       String    @unique
  courier        String
  awb            String
  status         String // scheduled | picked_up | in_transit | delivered | failed
  scheduledFor   DateTime?
  pickupWindow   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  returnRequest ReturnRequest   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  checkpoints   ShipmentCheckpoint[]

  @@unique([organizationId, awb])
}

model ShipmentCheckpoint {
  id         String   @id @default(cuid())
  shipmentId String
  status     String
  location   String?
  note       String?
  source     String // manual | webhook
  at         DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, at])
}

/// Outbound customer notification (email now; SMS/WhatsApp hook later).
model Notification {
  id             String    @id @default(cuid())
  organizationId String
  returnId       String?
  channel        String // email | sms | whatsapp
  to             String
  template       String
  subject        String?
  body           String
  status         String // sent | logged | failed | skipped
  provider       String // smtp | log | webhook
  error          String?
  createdAt      DateTime  @default(now())
  sentAt         DateTime?

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  returnRequest ReturnRequest? @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// ───────────────────────── Milestone 3 ─────────────────────────

/// Warehouse inspection of one returned line.
model Inspection {
  id             String   @id @default(cuid())
  organizationId String
  returnId       String
  returnItemId   String   @unique
  checklist      String // JSON { packaging, tags, damage, usage: "pass" | "fail" }
  grade          String // A | B | C | D
  disposition    String // restock | refurbish | damaged | dispose
  notes          String?
  aiSuggestion   String? // JSON { grade, disposition, mismatch, explanation, source }
  mismatch       Boolean  @default(false)
  inspectorId    String?
  inspectorName  String?
  createdAt      DateTime @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  returnRequest ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  returnItem    ReturnItem    @relation(fields: [returnItemId], references: [id], onDelete: Cascade)
}

/// Money (or goods) going back to the customer.
model Refund {
  id             String    @id @default(cuid())
  organizationId String
  returnId       String
  kind           String // refund | store_credit | replacement
  method         String // razorpay | manual | store_credit | replacement
  amountMinor    Int
  currency       String
  status         String // processing | succeeded | failed
  reference      String? // gateway refund id, credit code, replacement order number, bank/UPI ref
  gatewayMode    String? // live | test
  note           String?
  error          String?
  createdById    String?
  createdByName  String?
  createdAt      DateTime  @default(now())
  processedAt    DateTime?

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  returnRequest ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

/// Stock effect of an inspected item, and whether it was synced to the store.
model InventoryMovement {
  id             String   @id @default(cuid())
  organizationId String
  returnId       String
  returnItemId   String?
  sku            String
  name           String
  quantity       Int
  disposition    String // restock | refurbish | damaged | dispose
  syncStatus     String // synced | failed | not_required | not_connected
  syncTarget     String?
  syncMessage    String?
  createdAt      DateTime @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  returnRequest ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, sku])
}
